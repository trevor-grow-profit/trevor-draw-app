+type ImageCacheEntry = Parameters<AppClassProperties["imageCache"]["set"]>[1];
+
+/** The formats a full-resolution ImageBitmap draws pixel-for-pixel like the
+ * element itself, measured in Chromium through the editor and export paths
+ * (YAZ-2073 5B). Not SVG, which rasterises at the drawn size; not JPEG or AVIF,
+ * which the element path draws up to 48/255 differently. */
+const BITMAP_MIME_TYPES: ReadonlySet<string> = new Set([
+  MIME_TYPES.png,
+  MIME_TYPES.webp,
+  MIME_TYPES.gif,
+  MIME_TYPES.bmp,
+  MIME_TYPES.ico,
+]);
+
+/** The decoded-image cache. An ImageBitmap's pixels are not evictable, so an
+ * entry that is replaced or dropped frees its bitmap at once rather than
+ * whenever GC gets to it (YAZ-2073 D5). */
+export class ImageCache extends Map<FileId, ImageCacheEntry> {
+  set(fileId: FileId, entry: ImageCacheEntry) {
+    const bitmap = this.get(fileId)?.bitmap;
+    if (bitmap !== entry.bitmap) {
+      bitmap?.close();
+    }
+    return super.set(fileId, entry);
+  }
+
+  delete(fileId: FileId) {
+    this.get(fileId)?.bitmap?.close();
+    return super.delete(fileId);
+  }
+
+  clear() {
+    this.forEach((entry) => entry.bitmap?.close());
+    super.clear();
+  }
+}
