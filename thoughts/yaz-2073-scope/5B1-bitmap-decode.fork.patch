diff --git a/packages/element/tests/image.test.tsx b/packages/element/tests/image.test.tsx
new file mode 100644
index 00000000..15d6fcdc
--- /dev/null
+++ b/packages/element/tests/image.test.tsx
@@ -0,0 +1,185 @@
+import React from "react";
+import { vi } from "vitest";
+
+import { IMAGE_MIME_TYPES, MIME_TYPES } from "@excalidraw/common";
+
+import { Excalidraw, exportToCanvas } from "@excalidraw/excalidraw";
+
+import { API } from "@excalidraw/excalidraw/tests/helpers/api";
+import { mockHTMLImageElement } from "@excalidraw/excalidraw/tests/helpers/mocks";
+import {
+  render,
+  unmountComponent,
+  waitFor,
+} from "@excalidraw/excalidraw/tests/test-utils";
+
+import type { BinaryFiles, DataURL } from "@excalidraw/excalidraw/types";
+
+import { ImageCache, updateImageCache } from "../src/image";
+
+import type { FileId } from "../src/types";
+
+const { h } = window;
+
+const PNG = MIME_TYPES.png as string as FileId;
+
+/** one file per image format, keyed by its mime type */
+const files: BinaryFiles = Object.fromEntries(
+  Object.values(IMAGE_MIME_TYPES).map((mimeType) => [
+    mimeType,
+    {
+      id: mimeType as string as FileId,
+      mimeType,
+      dataURL: `data:${mimeType};base64,AAAA` as DataURL,
+      created: 1,
+    },
+  ]),
+);
+
+const bitmapOf = (imageCache: ImageCache, fileId: FileId) => {
+  const bitmap = imageCache.get(fileId)?.bitmap;
+  expect(bitmap).toBeDefined();
+  return bitmap!;
+};
+
+beforeEach(() => {
+  unmountComponent();
+  vi.restoreAllMocks();
+  mockHTMLImageElement(1440, 822);
+});
+
+describe("updateImageCache decodes raster images into bitmaps (YAZ-2073 D5)", () => {
+  it.each([
+    MIME_TYPES.png,
+    MIME_TYPES.webp,
+    MIME_TYPES.gif,
+    MIME_TYPES.bmp,
+    MIME_TYPES.ico,
+  ])("creates a bitmap from the loaded %s", async (mimeType) => {
+    const createImageBitmap = vi.spyOn(window, "createImageBitmap");
+    const fileId = mimeType as string as FileId;
+    const { imageCache } = await updateImageCache({
+      fileIds: [fileId],
+      files,
+      imageCache: new ImageCache(),
+    });
+
+    const entry = imageCache.get(fileId)!;
+    expect(entry.image).toBeInstanceOf(HTMLImageElement);
+    expect(createImageBitmap).toHaveBeenCalledWith(entry.image);
+    expect(entry.bitmap).toBe(await createImageBitmap.mock.results[0].value);
+  });
+
+  // SVG rasterises at the drawn size; JPEG and AVIF draw differently from a bitmap
+  it.each([MIME_TYPES.svg, MIME_TYPES.jpg, MIME_TYPES.jfif, MIME_TYPES.avif])(
+    "keeps %s as an element only",
+    async (mimeType) => {
+      const createImageBitmap = vi.spyOn(window, "createImageBitmap");
+      const fileId = mimeType as string as FileId;
+      const { imageCache } = await updateImageCache({
+        fileIds: [fileId],
+        files,
+        imageCache: new ImageCache(),
+      });
+
+      expect(imageCache.get(fileId)!.image).toBeInstanceOf(HTMLImageElement);
+      expect(imageCache.get(fileId)!.bitmap).toBeUndefined();
+      expect(createImageBitmap).not.toHaveBeenCalled();
+    },
+  );
+
+  it("falls back to the element when createImageBitmap fails", async () => {
+    vi.spyOn(window, "createImageBitmap").mockRejectedValue(
+      new DOMException("decode failed"),
+    );
+    const { imageCache, erroredFiles } = await updateImageCache({
+      fileIds: [PNG],
+      files,
+      imageCache: new ImageCache(),
+    });
+
+    expect(imageCache.get(PNG)!.image).toBeInstanceOf(HTMLImageElement);
+    expect(imageCache.get(PNG)!.bitmap).toBeUndefined();
+    expect(erroredFiles.size).toBe(0);
+  });
+});
+
+describe("ImageCache frees bitmaps it drops", () => {
+  const cached = async () =>
+    (
+      await updateImageCache({
+        fileIds: [PNG],
+        files,
+        imageCache: new ImageCache(),
+      })
+    ).imageCache as ImageCache;
+
+  it("on delete", async () => {
+    const imageCache = await cached();
+    const bitmap = bitmapOf(imageCache, PNG);
+    imageCache.delete(PNG);
+    expect(bitmap.close).toHaveBeenCalledTimes(1);
+  });
+
+  it("on clear", async () => {
+    const imageCache = await cached();
+    const bitmap = bitmapOf(imageCache, PNG);
+    imageCache.clear();
+    expect(bitmap.close).toHaveBeenCalledTimes(1);
+    expect(imageCache.size).toBe(0);
+  });
+
+  it("when the entry is re-initialised, but not when it is re-set as is", async () => {
+    const imageCache = await cached();
+    const bitmap = bitmapOf(imageCache, PNG);
+    imageCache.set(PNG, { ...imageCache.get(PNG)! });
+    expect(bitmap.close).not.toHaveBeenCalled();
+
+    await updateImageCache({ fileIds: [PNG], files, imageCache });
+    expect(bitmap.close).toHaveBeenCalledTimes(1);
+    expect(bitmapOf(imageCache, PNG)).not.toBe(bitmap);
+  });
+});
+
+describe("rendering draws from the bitmap", () => {
+  it("exports with the bitmap and frees it afterwards", async () => {
+    const createImageBitmap = vi.spyOn(window, "createImageBitmap");
+    const drawImage = vi.spyOn(CanvasRenderingContext2D.prototype, "drawImage");
+    const image = API.createElement({
+      type: "image",
+      fileId: PNG,
+      status: "saved",
+      width: 360,
+      height: 206,
+    });
+
+    await exportToCanvas({ elements: [image], files, appState: {} });
+
+    const bitmap = await createImageBitmap.mock.results[0].value;
+    expect(drawImage.mock.calls.map(([source]) => source)).toContain(bitmap);
+    expect(bitmap.close).toHaveBeenCalledTimes(1);
+  });
+
+  it("frees the editor's bitmaps when it unmounts", async () => {
+    const image = API.createElement({
+      type: "image",
+      fileId: PNG,
+      status: "saved",
+      width: 360,
+      height: 206,
+    });
+    await render(
+      <Excalidraw
+        initialData={{ elements: [image], files: { [PNG]: files[PNG] } }}
+      />,
+    );
+    await waitFor(() =>
+      expect(h.app.imageCache.get(PNG)?.bitmap).toBeDefined(),
+    );
+    const bitmap = h.app.imageCache.get(PNG)!.bitmap!;
+
+    unmountComponent();
+
+    expect(bitmap.close).toHaveBeenCalledTimes(1);
+  });
+});
