From 63473eb578d03ea0c2243bba577c1ed0550073ec Mon Sep 17 00:00:00 2001
From: scratch <scratch@local>
Date: Sun, 27 Sep 2026 22:35:17 -0700
Subject: [PATCH 5/5] test(fork): adapt upstream #12183 drag test to this
 fork's centered-text anchoring

---
 packages/element/tests/dragElements.test.ts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/packages/element/tests/dragElements.test.ts b/packages/element/tests/dragElements.test.ts
index 55d3fe04..90c71a1b 100644
--- a/packages/element/tests/dragElements.test.ts
+++ b/packages/element/tests/dragElements.test.ts
@@ -122,13 +122,16 @@ describe("dragSelectedElements", () => {
       syncInvalidIndices([rectangle, label, unrelated, second]),
     );
     const order = scene.getNonDeletedElements().map((element) => element.id);
+    // this fork anchors a centered text element on the given x, so read the
+    // label position back instead of assuming upstream's (10, 15)
+    const labelBefore = { x: label.x, y: label.y };
 
     drag(scene, [rectangle, second]);
 
     expect(scene.getNonDeletedElements().map(({ x, y }) => ({ x, y }))).toEqual(
       [
         { x: 20, y: 30 },
-        { x: 30, y: 45 },
+        { x: labelBefore.x + 20, y: labelBefore.y + 30 },
         { x: 500, y: 600 },
         { x: 220, y: 330 },
       ],
