From 328baed7ac659216425a01098c5000d451169b92 Mon Sep 17 00:00:00 2001
From: scratch <scratch@local>
Date: Sun, 27 Sep 2026 22:30:21 -0700
Subject: [PATCH 4/5] fix(fork): keep dark-mode look identical after upstream
 #12050

- smart-shape handles (fork-only) map their colors through
  applyDarkModeFilter, matching what the old CSS invert produced
- lasso trail keeps the fixed purple it always had (upstream moved it
  to --color-selection, which is #b4b0ff in dark mode)
- the DOM text-selection highlight keeps #3530c4 in dark mode via
  --color-wysiwyg-selection (upstream changed --color-selection)
---
 packages/excalidraw/css/styles.scss               |  6 +++++-
 packages/excalidraw/css/theme.scss                |  3 +++
 packages/excalidraw/lasso/index.ts                | 15 +++++----------
 packages/excalidraw/renderer/interactiveScene.ts  |  7 ++++++-
 packages/excalidraw/renderer/smartShapeHandles.ts | 11 ++++++++---
 5 files changed, 27 insertions(+), 15 deletions(-)

diff --git a/packages/excalidraw/css/styles.scss b/packages/excalidraw/css/styles.scss
index f657739f..4e56c0ff 100644
--- a/packages/excalidraw/css/styles.scss
+++ b/packages/excalidraw/css/styles.scss
@@ -46,7 +46,11 @@ body.excalidraw-cursor-resize * {
   }
 
   .excalidraw-wysiwyg-selection {
-    background: color-mix(in srgb, var(--color-selection) 35%, transparent);
+    background: color-mix(
+      in srgb,
+      var(--color-wysiwyg-selection, var(--color-selection)) 35%,
+      transparent
+    );
   }
 
   .excalidraw-wysiwyg-caret {
diff --git a/packages/excalidraw/css/theme.scss b/packages/excalidraw/css/theme.scss
index ad7cf55b..619aa045 100644
--- a/packages/excalidraw/css/theme.scss
+++ b/packages/excalidraw/css/theme.scss
@@ -227,6 +227,9 @@
 
     // will be inverted to a lighter color.
     --color-selection: #b4b0ff;
+    // the DOM text-selection highlight was never inverted, so it keeps the
+    // pre-#12050 dark value
+    --color-wysiwyg-selection: #3530c4;
 
     --color-icon-white: var(--color-gray-90);
 
diff --git a/packages/excalidraw/lasso/index.ts b/packages/excalidraw/lasso/index.ts
index e419da0c..3abdb03a 100644
--- a/packages/excalidraw/lasso/index.ts
+++ b/packages/excalidraw/lasso/index.ts
@@ -17,12 +17,7 @@ import { selectGroupsForSelectedElements } from "@excalidraw/element";
 
 import { getContainerElement } from "@excalidraw/element";
 
-import {
-  arrayToMap,
-  easeOut,
-  isShallowEqual,
-  setColorAlpha,
-} from "@excalidraw/common";
+import { arrayToMap, easeOut, isShallowEqual } from "@excalidraw/common";
 
 import type {
   ExcalidrawElement,
@@ -31,7 +26,6 @@ import type {
 } from "@excalidraw/element/types";
 
 import { AnimatedTrail } from "../animatedTrail";
-import { getSelectionColor } from "../renderer/helpers";
 
 import { getLassoSelectedElementIds } from "./utils";
 
@@ -69,9 +63,10 @@ export class LassoTrail extends AnimatedTrail {
 
         return Math.min(easeOut(l), easeOut(t));
       },
-      // same color as the marquee selection (theme-aware, host-overridable)
-      fill: () => setColorAlpha(getSelectionColor(app.interactiveCanvas), 0.05),
-      stroke: () => getSelectionColor(app.interactiveCanvas),
+      // kept as the fixed light-theme purple in both themes (upstream #12050
+      // switched it to --color-selection; that would change how dark mode looks)
+      fill: () => "rgba(105,101,219,0.05)",
+      stroke: () => "rgba(105,101,219)",
     });
   }
 
diff --git a/packages/excalidraw/renderer/interactiveScene.ts b/packages/excalidraw/renderer/interactiveScene.ts
index 552127b3..45a0bd76 100644
--- a/packages/excalidraw/renderer/interactiveScene.ts
+++ b/packages/excalidraw/renderer/interactiveScene.ts
@@ -2012,7 +2012,12 @@ const _renderInteractiveScene = ({
           !appState.isRotating &&
           getSmartShapeMetadata(selectedElements[0])
         ) {
-          renderSmartShapeHandles(context, selectedElements[0], appState.zoom);
+          renderSmartShapeHandles(
+            context,
+            selectedElements[0],
+            appState.zoom,
+            appState.theme,
+          );
         }
       }
 
diff --git a/packages/excalidraw/renderer/smartShapeHandles.ts b/packages/excalidraw/renderer/smartShapeHandles.ts
index d822b4ff..c5f9d1bf 100644
--- a/packages/excalidraw/renderer/smartShapeHandles.ts
+++ b/packages/excalidraw/renderer/smartShapeHandles.ts
@@ -1,18 +1,23 @@
+import { THEME, applyDarkModeFilter } from "@excalidraw/common";
 import { getSmartShapeHandles } from "@excalidraw/element";
 
 import type { ExcalidrawLinearElement } from "@excalidraw/element/types";
 
-import type { Zoom } from "../types";
+import type { AppState, Zoom } from "../types";
 
 export const renderSmartShapeHandles = (
   context: CanvasRenderingContext2D,
   element: ExcalidrawLinearElement,
   zoom: Zoom,
+  theme: AppState["theme"],
 ) => {
+  // the interactive canvas is no longer inverted by a CSS filter in dark mode,
+  // so map the light-mode colors to their former post-filter values here
+  const isDark = theme === THEME.DARK;
   const radius = 7 / zoom.value;
   context.save();
-  context.fillStyle = "#ffffff";
-  context.strokeStyle = "#6965db";
+  context.fillStyle = applyDarkModeFilter("#ffffff", isDark);
+  context.strokeStyle = applyDarkModeFilter("#6965db", isDark);
   context.lineWidth = 2 / zoom.value;
   for (const { scenePoint } of getSmartShapeHandles(element)) {
     context.beginPath();
-- 
